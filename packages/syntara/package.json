{
  "name": "syntara",
  "version": "0.3.0",
  "description": "An accessible design system, set up by one command. `npx syntara init` writes a light and dark theme that passes WCAG 2.2 AA contrast, installs the React components and icon set, and adds two style imports and a ThemeScope to your app's entry file (in a terminal it shows the change and asks first; --no-edit skips it). Also includes the token CSS for every brand and the theme engine.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anujpatel06/syntara.git",
    "directory": "packages/syntara"
  },
  "homepage": "https://syntara.live",
  "bugs": "https://github.com/anujpatel06/syntara/issues",
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "syntara": "./bin/syntara.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./icons": {
      "types": "./src/icons.d.ts",
      "default": "./src/icons.js"
    },
    "./theme-engine": {
      "types": "./src/theme-engine.d.ts",
      "default": "./src/theme-engine.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "prepack": "pnpm run build",
    "build": "node scripts/build.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@syntara/icons": "workspace:^",
    "@syntara/react": "workspace:^",
    "@syntara/theme-engine": "workspace:^",
    "@syntara/tokens": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "keywords": [
    "design-system",
    "react",
    "react-aria",
    "theming",
    "design-tokens",
    "multi-brand",
    "accessibility"
  ],
  "devDependencies": {
    "vitest": "^5.0.0"
  }
}
