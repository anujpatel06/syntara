{
  "name": "@syntara/icons-niche",
  "version": "0.1.0",
  "description": "2,000 niche outline icons for @syntara/icons: healthcare specialties, dental, finance, legal, farming, aviation and 30 more domains, in the same curvy 24px style.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anujpatel06/syntara.git",
    "directory": "packages/icons-niche"
  },
  "homepage": "https://github.com/anujpatel06/syntara/tree/main/packages/icons-niche#readme",
  "bugs": "https://github.com/anujpatel06/syntara/issues",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check:drawing": "tsx scripts/check-drawing.ts",
    "sheet": "tsx scripts/sheet.tsx"
  },
  "peerDependencies": {
    "@syntara/icons": "^0.1.1",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "@syntara/icons": "workspace:*"
  },
  "keywords": [
    "icons",
    "react",
    "svg",
    "icon-set",
    "healthcare",
    "finance",
    "design-system"
  ]
}
